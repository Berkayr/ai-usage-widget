{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Widget windows: core events, window drag and size.",
  "windows": ["main", "widget-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}
