# Binary package draft. Place the reviewed AppImage beside this file.
# Save as PKGBUILD and replace REPLACE_WITH_VERIFIED_SHA256 with the published checksum before use.
pkgname=ai-usage-widget-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Desktop AI subscription quota widget (prebuilt AppImage)'
arch=('x86_64')
license=('custom')
provides=('ai-usage-widget')
conflicts=('ai-usage-widget')
depends=('fuse2' 'python')
optdepends=('gtk-layer-shell: native Wayland corner placement')
source=("ai-usage-widget-$pkgver-x86_64.AppImage")
sha256sums=('REPLACE_WITH_VERIFIED_SHA256')

package() {
  install -Dm755 "ai-usage-widget-$pkgver-x86_64.AppImage" "$pkgdir/opt/ai-usage-widget/ai-usage-widget.AppImage"
  install -dm755 "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
  printf '#!/bin/sh\nexec /opt/ai-usage-widget/ai-usage-widget.AppImage "$@"\n' > "$pkgdir/usr/bin/ai-usage"
  chmod 755 "$pkgdir/usr/bin/ai-usage"
  printf '[Desktop Entry]\nType=Application\nName=AI Usage\nExec=ai-usage\nTerminal=false\nCategories=Utility;Monitor;\n' > "$pkgdir/usr/share/applications/ai-usage.desktop"
}
